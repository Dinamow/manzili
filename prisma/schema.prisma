generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["manzili"]
}

// ─── EXISTING TABLES (extended) ──────────────────────────────────────────────

model addresses {
  id                                Int                                 @id @default(autoincrement())
  city                              String?                             @db.VarChar(50)
  street                            String?                             @db.VarChar(100)
  buildingnumber                    String?                             @db.VarChar(20)
  apartmentnumber                   String?                             @db.VarChar(20)
  zipcode                           String?                             @db.VarChar(20)
  personid                          Int?
  // New columns
  name                              String?                             @db.VarChar(100)
  email                             String?                             @db.VarChar(100)
  phone                             String?                             @db.VarChar(20)
  zone                              String?                             @db.VarChar(100)
  district                          String?                             @db.VarChar(100)
  floor                             String?                             @db.VarChar(20)
  postalcode                        String?                             @db.VarChar(20)
  bosta_city_id                     String?                             @db.VarChar(50)
  bosta_zone_id                     String?                             @db.VarChar(50)
  bosta_district_id                 String?                             @db.VarChar(50)
  // Relations
  person                            person?                             @relation(fields: [personid], references: [personid], onUpdate: NoAction)
  addresses_and_contact_phonenumber addresses_and_contact_phonenumber[]
  orders                            orders[]                            @relation("order_address")
  offer_payments                    offer_payments[]

  @@schema("manzili")
}

model addresses_and_contact_phonenumber {
  phonenumber String    @db.VarChar(20)
  addressid   Int
  addresses   addresses @relation(fields: [addressid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([phonenumber, addressid])
  @@schema("manzili")
}

model cart {
  cartid       Int            @id @default(autoincrement())
  creatorid    Int?
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  person       person?        @relation(fields: [creatorid], references: [personid], onDelete: Cascade, onUpdate: NoAction)
  cart_contain cart_contain[]

  @@schema("manzili")
}

model cart_contain {
  number_of_products Int?     @default(0)
  cartid             Int
  productid          Int
  cart               cart     @relation(fields: [cartid], references: [cartid], onDelete: Cascade, onUpdate: NoAction)
  products           products @relation(fields: [productid], references: [productid], onDelete: Cascade, onUpdate: NoAction)

  @@id([cartid, productid])
  @@schema("manzili")
}

model category {
  categoryid     Int              @id @default(autoincrement()) @db.SmallInt
  category_name  String           @db.VarChar(25)
  custom_request custom_request[]
  products       products[]

  @@schema("manzili")
}

model color_palette {
  color_paletteid   Int            @default(autoincrement())
  color_code        String         @db.VarChar(20)
  color_description String         @db.VarChar(100)
  requestid         Int
  custom_request    custom_request @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction)

  @@id([color_paletteid, requestid])
  @@schema("manzili")
}

model consist_of {
  quantity          Int
  price_at_purchase Decimal  @db.Decimal(12, 2)
  orderid           Int
  productid         Int
  orders            orders   @relation(fields: [orderid], references: [orderid], onDelete: Cascade, onUpdate: NoAction)
  products          products @relation(fields: [productid], references: [productid], onDelete: NoAction, onUpdate: NoAction)

  @@id([orderid, productid])
  @@schema("manzili")
}

model conversation {
  conversationid Int        @id @default(autoincrement())
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  lastmessageat  DateTime?  @db.Timestamp(6)
  enduserid      Int
  sellerid       Int
  enduser        enduser    @relation(fields: [enduserid], references: [enduserid], onDelete: NoAction, onUpdate: NoAction)
  seller         seller     @relation(fields: [sellerid], references: [sellerid], onDelete: NoAction, onUpdate: NoAction)
  messages       messages[]

  @@schema("manzili")
}

model coupon_product {
  coupon_productid Int      @id @default(autoincrement())
  couponid         Int
  productid        Int
  coupons          coupons  @relation(fields: [couponid], references: [couponid], onDelete: Cascade, onUpdate: NoAction)
  products         products @relation(fields: [productid], references: [productid], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  couponid            Int              @id @default(autoincrement())
  description         String           @db.VarChar(500)
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  status              Boolean?         @default(true)
  expired_date        DateTime?        @db.Timestamp(6)
  scope               Int              @db.SmallInt
  creatorid           Int
  storeid             Int?
  // New columns
  code                String?          @unique @db.VarChar(50)
  discount_percentage Decimal?         @db.Decimal(5, 2)
  max_users           Int?             @default(100)
  used_count          Int?             @default(0)
  // Relations
  coupon_product      coupon_product[]
  person              person           @relation(fields: [creatorid], references: [personid], onDelete: Cascade, onUpdate: NoAction)
  seller              seller?          @relation(fields: [storeid], references: [sellerid], onDelete: Cascade, onUpdate: NoAction)
  user_coupons        user_coupons[]

  @@schema("manzili")
}

model custom_request {
  requestid             Int                  @id @default(autoincrement())
  itemname              String               @db.VarChar(100)
  description           String               @db.VarChar(1000)
  visibility            Boolean              @default(true)
  quantity              Int?                 @default(1) @db.SmallInt
  lenght                Float?
  width                 Float?
  hight                 Float?
  matrial               String?              @db.VarChar(255)
  desired_delivery_date DateTime?            @db.Date
  created_at            DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  status                Int?                 @db.SmallInt
  enduserid             Int
  categoryid            Int
  // New columns
  sellerid              Int?
  image_urls            String[]
  voicememo_url         String?              @db.VarChar(500)
  // Relations
  color_palette         color_palette[]
  category              category             @relation(fields: [categoryid], references: [categoryid], onDelete: NoAction, onUpdate: NoAction)
  enduser               enduser              @relation(fields: [enduserid], references: [enduserid], onDelete: NoAction, onUpdate: NoAction)
  seller                seller?              @relation(fields: [sellerid], references: [sellerid], onUpdate: NoAction)
  visual_inspiration    visual_inspiration[]
  voicememo             voicememo[]
  offers                offers[]
  reports               reports[]            @relation("report_custom_request")

  @@schema("manzili")
}

model customized_order {
  orderid Int    @id
  orders  orders @relation(fields: [orderid], references: [orderid], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}

model enduser {
  enduserid            Int                    @id @default(autoincrement())
  wichlistid           Int?
  personid             Int                    @unique
  conversation         conversation[]
  custom_request       custom_request[]
  person               person                 @relation(fields: [personid], references: [personid], onDelete: Cascade, onUpdate: NoAction)
  wishlist             wishlist?              @relation(fields: [wichlistid], references: [wichlistid], onUpdate: NoAction)
  follow               follow[]
  orders               orders[]
  reviewing_and_rating reviewing_and_rating[]

  @@schema("manzili")
}

model follow {
  followed_at DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  enduserid   Int
  sellerid    Int
  enduser     enduser   @relation(fields: [enduserid], references: [enduserid], onDelete: NoAction, onUpdate: NoAction)
  seller      seller    @relation(fields: [sellerid], references: [sellerid], onDelete: Cascade, onUpdate: NoAction)

  @@id([enduserid, sellerid])
  @@schema("manzili")
}

model messages {
  messageid      Int          @default(autoincrement())
  messagecontent String
  sent_at        DateTime     @default(now()) @db.Timestamp(5)
  isread         Boolean?     @default(false)
  conversationid Int
  conversation   conversation @relation(fields: [conversationid], references: [conversationid], onDelete: Cascade, onUpdate: NoAction)

  @@id([messageid, conversationid])
  @@schema("manzili")
}

model notification {
  notification_id     Int      @id @default(autoincrement())
  tittle              String   @db.VarChar(100)
  notificationcontent String   @db.VarChar(700)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  is_read             Boolean? @default(false)
  personid            Int
  // New columns
  type                String?  @db.VarChar(50)
  href                String?  @db.VarChar(500)
  // Relations
  person              person   @relation(fields: [personid], references: [personid], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}

model orders {
  orderid                  Int               @id @default(autoincrement())
  status                   Int?              @db.SmallInt
  shippingcost             Decimal?          @db.Decimal(10, 2)
  totalamount              Decimal?          @db.Decimal(12, 2)
  paymentid                Int
  paymentmethod            Int?              @db.SmallInt
  psp                      String?           @db.VarChar(50)
  paymentstatus            Int?              @db.SmallInt
  transaction_ref          String?           @db.VarChar(50)
  paid_at                  DateTime          @db.Timestamp(6)
  shipmentid               Int?
  sellerid                 Int?
  enduserid                Int?
  // New columns
  stripe_payment_intent_id String?           @db.VarChar(200)
  is_paid                  Boolean?          @default(false)
  address_id               Int?
  coupon_snapshot          Json?
  created_at               DateTime?         @default(now()) @db.Timestamp(6)
  // Relations
  consist_of               consist_of[]
  customized_order         customized_order?
  enduser                  enduser?          @relation(fields: [enduserid], references: [enduserid], onUpdate: NoAction)
  seller                   seller?           @relation(fields: [sellerid], references: [sellerid], onUpdate: NoAction)
  shipment                 shipment?         @relation(fields: [shipmentid], references: [shipmentid], onUpdate: NoAction)
  address                  addresses?        @relation("order_address", fields: [address_id], references: [id], onUpdate: NoAction)
  returns                  returns[]
  standard_order           standard_order?
  user_coupons             user_coupons[]
  store_orders             store_orders[]

  @@schema("manzili")
}

model payout {
  payoutid        Int       @id @default(autoincrement())
  amount          Decimal?  @db.Decimal(12, 2)
  status          Int?
  request_at_time DateTime? @db.Timestamp(6)
  paid_at         DateTime? @default(now()) @db.Timestamp(6)
  sellerid        Int?
  seller          seller?   @relation(fields: [sellerid], references: [sellerid], onUpdate: NoAction)

  @@schema("manzili")
}

model person {
  personid           Int                  @id @default(autoincrement())
  email              String               @unique @db.VarChar(100)
  password           String               @db.VarChar(100)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  first_name         String?              @db.VarChar(50)
  last_name          String?              @db.VarChar(50)
  // New columns
  image_url          String?              @db.VarChar(500)
  refresh_token      String?              @db.VarChar(500)
  // Relations
  addresses          addresses[]
  cart               cart[]
  coupons            coupons[]
  enduser            enduser?
  notification       notification[]
  person_permissions person_permissions[]
  seller             seller?
  systemadmin        systemadmin?
  user_coupons       user_coupons[]
  reports            reports[]            @relation("report_reporter")

  @@schema("manzili")
}

model person_permissions {
  permission Int
  personid   Int
  person     person @relation(fields: [personid], references: [personid], onDelete: Cascade, onUpdate: NoAction)

  @@id([permission, personid])
  @@schema("manzili")
}

model product_images {
  product_imageid Int      @default(autoincrement())
  productimage    Bytes
  upload_date     DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  productid       Int
  // New column
  image_url       String?  @db.VarChar(500)
  // Relations
  products        products @relation(fields: [productid], references: [productid], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_imageid, productid])
  @@schema("manzili")
}

model products {
  productid               Int                    @id @default(autoincrement())
  productname             String                 @db.VarChar(100)
  cover                   Bytes?
  categoryid              Int?                   @db.SmallInt
  sellerid                Int?
  // New columns
  description             String?                @db.VarChar(2000)
  price                   Decimal?               @db.Decimal(12, 2)
  mrp                     Decimal?               @db.Decimal(12, 2)
  stock                   Int?                   @default(10)
  in_stock                Boolean?               @default(true)
  cover_url               String?                @db.VarChar(500)
  shipping_size           String?                @db.VarChar(20)
  shipping_bulky_category String?                @db.VarChar(20)
  is_disabled             Boolean?               @default(false)
  created_at              DateTime?              @default(now()) @db.Timestamp(6)
  updated_at              DateTime?              @updatedAt
  // Relations
  cart_contain            cart_contain[]
  consist_of              consist_of[]
  coupon_product          coupon_product[]
  product_images          product_images[]
  category                category?              @relation(fields: [categoryid], references: [categoryid], onUpdate: NoAction)
  seller                  seller?                @relation(fields: [sellerid], references: [sellerid], onDelete: Cascade, onUpdate: NoAction)
  reviewing_and_rating    reviewing_and_rating[]
  whishlist_contain       whishlist_contain[]
  product_variants        product_variants[]
  store_order_items       store_order_items[]

  @@schema("manzili")
}

model proof_as_images {
  imageid      Int     @default(autoincrement())
  evidence_url String? @db.VarChar(500)
  the_image    Bytes?
  returnid     Int
  returns      returns @relation(fields: [returnid], references: [returnid], onDelete: Cascade, onUpdate: NoAction)

  @@id([imageid, returnid])
  @@schema("manzili")
}

model returns {
  returnid        Int               @id @default(autoincrement())
  reason          String            @db.VarChar(1000)
  status          Int?              @db.SmallInt
  requestdate     DateTime          @default(now()) @db.Timestamp(6)
  orderid         Int
  // New columns
  store_orderid   Int?
  refund_amount   Decimal?          @db.Decimal(12, 2)
  // Relations
  proof_as_images proof_as_images[]
  orders          orders            @relation(fields: [orderid], references: [orderid], onDelete: Cascade, onUpdate: NoAction)
  store_order     store_orders?     @relation(fields: [store_orderid], references: [store_orderid], onUpdate: NoAction)

  @@schema("manzili")
}

model reviewing_and_rating {
  rating     Float
  comment    String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamp(6)
  enduserid  Int
  productid  Int
  // New columns
  orderid    Int?
  // Relations
  enduser    enduser  @relation(fields: [enduserid], references: [enduserid], onDelete: NoAction, onUpdate: NoAction)
  products   products @relation(fields: [productid], references: [productid], onDelete: Cascade, onUpdate: NoAction)

  @@id([enduserid, productid])
  @@schema("manzili")
}

model seller {
  sellerid                 Int                     @id @default(autoincrement())
  storename                String?                 @db.VarChar(100)
  store_description        String?
  storelogo                Bytes?
  sellerwallet_balance     Decimal?                @default(0.00) @db.Decimal(12, 2)
  personid                 Int                     @unique
  // New columns
  email                    String?                 @db.VarChar(100)
  phone                    String?                 @db.VarChar(20)
  address_text             String?                 @db.VarChar(500)
  username                 String?                 @unique @db.VarChar(100)
  store_status             String?                 @default("pending") @db.VarChar(20)
  is_active                Boolean?                @default(false)
  logo_url                 String?                 @db.VarChar(500)
  bosta_pickup_location_id String?                 @db.VarChar(100)
  created_at               DateTime?               @default(now()) @db.Timestamp(6)
  updated_at               DateTime?               @updatedAt
  // Relations
  conversation             conversation[]
  coupons                  coupons[]
  follow                   follow[]
  orders                   orders[]
  payout                   payout[]
  products                 products[]
  person                   person                  @relation(fields: [personid], references: [personid], onDelete: Cascade, onUpdate: NoAction)
  store_orders             store_orders[]
  seller_wallet            seller_wallet?
  store_pickup_address     store_pickup_addresses?
  custom_requests          custom_request[]
  offers                   offers[]
  reports                  reports[]               @relation("report_seller")

  @@schema("manzili")
}

model shipment {
  shipmentid        Int               @id @default(autoincrement())
  carrier           String?           @db.VarChar(100)
  shipment_status   Int?              @db.SmallInt
  shipped_at_time   DateTime?         @db.Timestamp(6)
  delivered_at_time DateTime?         @db.Date
  tracking_number   String?           @db.VarChar(50)
  // New columns
  store_orderid     Int?              @unique
  bosta_delivery_id String?           @db.VarChar(100)
  awb_url           String?           @db.VarChar(500)
  shipping_cost     Decimal?          @db.Decimal(10, 2)
  cod_amount        Decimal?          @db.Decimal(12, 2)
  size              String?           @db.VarChar(20)
  status_text       String?           @db.VarChar(30)
  // Relations
  orders            orders[]
  store_order       store_orders?     @relation(fields: [store_orderid], references: [store_orderid], onUpdate: NoAction)
  shipment_events   shipment_events[]

  @@schema("manzili")
}

model standard_order {
  orderid Int    @id
  orders  orders @relation(fields: [orderid], references: [orderid], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}

model systemadmin {
  adminid           Int           @id @default(autoincrement())
  supervisorid      Int?
  personid          Int           @unique
  person            person        @relation(fields: [personid], references: [personid], onDelete: Cascade, onUpdate: NoAction)
  systemadmin       systemadmin?  @relation("systemadminTosystemadmin", fields: [supervisorid], references: [adminid], onDelete: NoAction, onUpdate: NoAction)
  other_systemadmin systemadmin[] @relation("systemadminTosystemadmin")

  @@schema("manzili")
}

model user_coupons {
  used_couponid Int      @id @default(autoincrement())
  used_at       DateTime @default(now()) @db.Timestamp(6)
  couponid      Int
  userid        Int
  orderid       Int
  coupons       coupons  @relation(fields: [couponid], references: [couponid], onDelete: NoAction, onUpdate: NoAction)
  orders        orders   @relation(fields: [orderid], references: [orderid], onDelete: Cascade, onUpdate: NoAction)
  person        person   @relation(fields: [userid], references: [personid], onDelete: NoAction, onUpdate: NoAction)

  @@schema("manzili")
}

model visual_inspiration {
  imageid        Int            @default(autoincrement())
  the_image      Bytes?
  imageurl       String?        @db.VarChar(500)
  requestid      Int
  custom_request custom_request @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction)

  @@id([imageid, requestid])
  @@schema("manzili")
}

model voicememo {
  recordingid    Int            @default(autoincrement())
  duration       Float?
  send_at        DateTime?      @default(now()) @db.Timestamp(6)
  record         Bytes?
  requestid      Int
  custom_request custom_request @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction)

  @@id([recordingid, requestid])
  @@schema("manzili")
}

model whishlist_contain {
  wichlistid Int
  productid  Int
  products   products @relation(fields: [productid], references: [productid], onDelete: Cascade, onUpdate: NoAction)
  wishlist   wishlist @relation(fields: [wichlistid], references: [wichlistid], onDelete: Cascade, onUpdate: NoAction)

  @@id([wichlistid, productid])
  @@schema("manzili")
}

model wishlist {
  wichlistid        Int                 @id @default(autoincrement())
  numberofproducts  Int?                @default(0)
  enduser           enduser[]
  whishlist_contain whishlist_contain[]

  @@schema("manzili")
}

// ─── NEW TABLES ──────────────────────────────────────────────────────────────

model store_orders {
  store_orderid       Int                   @id @default(autoincrement())
  orderid             Int
  sellerid            Int
  subtotal            Decimal               @db.Decimal(12, 2)
  discount_total      Decimal               @default(0) @db.Decimal(12, 2)
  shipping_total      Decimal               @default(0) @db.Decimal(12, 2)
  total               Decimal               @db.Decimal(12, 2)
  status              String                @default("ORDER_PLACED") @db.VarChar(30)
  is_paid             Boolean               @default(false)
  payment_method      String                @db.VarChar(20)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @updatedAt
  // Relations
  order               orders                @relation(fields: [orderid], references: [orderid], onDelete: Cascade, onUpdate: NoAction)
  seller              seller                @relation(fields: [sellerid], references: [sellerid], onUpdate: NoAction)
  items               store_order_items[]
  shipment            shipment?
  returns             returns[]
  wallet_transactions wallet_transactions[]

  @@schema("manzili")
}

model store_order_items {
  item_id            Int          @id @default(autoincrement())
  store_orderid      Int
  productid          Int
  quantity           Int
  price_at_purchase  Decimal      @db.Decimal(12, 2)
  product_name       String       @db.VarChar(100)
  product_image_url  String?      @db.VarChar(500)
  shipping_size      String?      @db.VarChar(20)
  shipping_bulky_cat String?      @db.VarChar(20)
  created_at         DateTime     @default(now()) @db.Timestamp(6)
  // Relations
  store_order        store_orders @relation(fields: [store_orderid], references: [store_orderid], onDelete: Cascade, onUpdate: NoAction)
  product            products     @relation(fields: [productid], references: [productid], onUpdate: NoAction)

  @@schema("manzili")
}

model seller_wallet {
  wallet_id           Int                   @id @default(autoincrement())
  sellerid            Int                   @unique
  pending_balance     Decimal               @default(0) @db.Decimal(12, 2)
  available_balance   Decimal               @default(0) @db.Decimal(12, 2)
  currency            String                @default("EGP") @db.VarChar(10)
  stripe_account_id   String?               @db.VarChar(100)
  bank_name           String?               @db.VarChar(100)
  bank_account_holder String?               @db.VarChar(200)
  bank_last4          String?               @db.VarChar(4)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @updatedAt
  // Relations
  seller              seller                @relation(fields: [sellerid], references: [sellerid], onDelete: Cascade, onUpdate: NoAction)
  transactions        wallet_transactions[]

  @@schema("manzili")
}

model wallet_transactions {
  transaction_id  Int           @id @default(autoincrement())
  wallet_id       Int
  type            String        @db.VarChar(30)
  bucket          String        @db.VarChar(20)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("EGP") @db.VarChar(10)
  idempotency_key String        @db.VarChar(200)
  orderid         Int?
  store_orderid   Int?
  shipmentid      Int?
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  // Relations
  wallet          seller_wallet @relation(fields: [wallet_id], references: [wallet_id], onDelete: Cascade, onUpdate: NoAction)
  store_order     store_orders? @relation(fields: [store_orderid], references: [store_orderid], onUpdate: NoAction)

  @@unique([wallet_id, idempotency_key])
  @@schema("manzili")
}

model shipment_events {
  event_id     Int      @id @default(autoincrement())
  shipmentid   Int
  event_type   String   @db.VarChar(50)
  occurred_at  DateTime @default(now()) @db.Timestamp(6)
  payload_hash String   @db.VarChar(64)
  raw_payload  Json
  created_at   DateTime @default(now()) @db.Timestamp(6)
  // Relations
  shipment     shipment @relation(fields: [shipmentid], references: [shipmentid], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shipmentid, payload_hash])
  @@schema("manzili")
}

model store_pickup_addresses {
  pickup_id         Int       @id @default(autoincrement())
  sellerid          Int       @unique
  first_line        String    @db.VarChar(200)
  city              String    @db.VarChar(100)
  bosta_city_id     String?   @db.VarChar(50)
  bosta_zone_id     String?   @db.VarChar(50)
  bosta_district_id String?   @db.VarChar(50)
  phone             String?   @db.VarChar(20)
  contact_name      String?   @db.VarChar(100)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @updatedAt
  // Relations
  seller            seller    @relation(fields: [sellerid], references: [sellerid], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}

model bosta_address_mapping {
  mapping_id    Int       @id @default(autoincrement())
  country       String    @db.VarChar(10)
  city_name     String    @db.VarChar(100)
  zone_name     String?   @db.VarChar(100)
  district_name String?   @db.VarChar(100)
  city_id       String?   @db.VarChar(50)
  zone_id       String?   @db.VarChar(50)
  district_id   String?   @db.VarChar(50)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt

  @@index([country, city_name])
  @@schema("manzili")
}

model reports {
  report_id        Int             @id @default(autoincrement())
  reporter_id      Int?
  type             String          @db.VarChar(50)
  reason           String          @db.VarChar(500)
  description      String?         @db.VarChar(2000)
  status           String          @default("PENDING") @db.VarChar(20)
  admin_note       String?         @db.VarChar(1000)
  productid        Int?
  sellerid         Int?
  store_orderid    Int?
  custom_requestid Int?
  resolved_at      DateTime?       @db.Timestamp(6)
  created_at       DateTime        @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @updatedAt
  // Relations
  reporter         person?         @relation("report_reporter", fields: [reporter_id], references: [personid], onUpdate: NoAction)
  seller           seller?         @relation("report_seller", fields: [sellerid], references: [sellerid], onUpdate: NoAction)
  custom_request   custom_request? @relation("report_custom_request", fields: [custom_requestid], references: [requestid], onUpdate: NoAction)

  @@schema("manzili")
}

model offers {
  offer_id             Int              @id @default(autoincrement())
  requestid            Int
  sellerid             Int
  price                Decimal          @db.Decimal(12, 2)
  description          String?          @db.VarChar(2000)
  status               String           @default("pending") @db.VarChar(30)
  seller_comment       String?          @db.VarChar(1000)
  buyer_comment        String?          @db.VarChar(1000)
  accepted_at          DateTime?        @db.Timestamp(6)
  first_paid_at        DateTime?        @db.Timestamp(6)
  progress_uploaded_at DateTime?        @db.Timestamp(6)
  second_paid_at       DateTime?        @db.Timestamp(6)
  ready_to_ship_at     DateTime?        @db.Timestamp(6)
  paid_at              DateTime?        @db.Timestamp(6)
  created_at           DateTime         @default(now()) @db.Timestamp(6)
  updated_at           DateTime?        @updatedAt
  // Relations
  custom_request       custom_request   @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction)
  seller               seller           @relation(fields: [sellerid], references: [sellerid], onUpdate: NoAction)
  offer_messages       offer_messages[]
  offer_payments       offer_payments[]

  @@schema("manzili")
}

model offer_messages {
  message_id  Int      @id @default(autoincrement())
  offer_id    Int
  author_type String   @db.VarChar(10)
  author_id   Int
  text        String   @db.VarChar(2000)
  image_url   String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  // Relations
  offer       offers   @relation(fields: [offer_id], references: [offer_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}

model offer_payments {
  payment_id     Int        @id @default(autoincrement())
  offer_id       Int
  milestone      String     @db.VarChar(20)
  amount         Decimal    @db.Decimal(12, 2)
  payment_method String     @db.VarChar(20)
  address_id     Int?
  paid_at        DateTime   @default(now()) @db.Timestamp(6)
  // Relations
  offer          offers     @relation(fields: [offer_id], references: [offer_id], onDelete: Cascade, onUpdate: NoAction)
  address        addresses? @relation(fields: [address_id], references: [id], onUpdate: NoAction)

  @@schema("manzili")
}

model product_variants {
  variant_id   Int               @id @default(autoincrement())
  productid    Int
  variant_name String            @db.VarChar(100)
  // Relations
  product      products          @relation(fields: [productid], references: [productid], onDelete: Cascade, onUpdate: NoAction)
  options      variant_options[]

  @@schema("manzili")
}

model variant_options {
  option_id  Int              @id @default(autoincrement())
  variant_id Int
  value      String           @db.VarChar(100)
  stock      Int              @default(0)
  // Relations
  variant    product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("manzili")
}
